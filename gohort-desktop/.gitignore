# Wails build outputs
build/bin/
build/darwin/
build/windows/
build/linux/

# Frontend dist (we don't use it but Wails generates it)
frontend/dist/
node_modules/

# macOS bundle artifacts
*.app/
*.dmg

# Local config overrides
desktop.conf.local

# stray bridge binaries (built to /Applications or via -o). Anchored to this
# directory: a bare "gohort-bridge" also matched cmd/gohort-bridge/, the
# source, which is how the entry point went uncommitted and got lost once.
/gohort-bridge
/gohort-bridge.exe

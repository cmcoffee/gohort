{
  "id": "elevenlabs-speech",
  "title": "ElevenLabs (speech)",
  "description": "ElevenLabs text-to-speech as gohort's voice, declared as a service: the request, the voice and the reply are data you can test and fix from Admin > Connectors.",
  "category": "Speech",
  "setup_notes": "Get an API key at elevenlabs.io (Profile > API keys). Choose it under Capabilities > Speech (TTS), where its model is set and its key can be changed; Test there speaks a short sentence. ElevenLabs bills in credits by the character, so no price is declared: the connector shows its calls as unpriced until you add a cost to its spec (per_unit with unit character).",
  "questions": [
    {
      "name": "name",
      "label": "Connector name",
      "help": "Lowercase letters, digits, dashes and underscores; the speech settings list it by this name.",
      "default": "elevenlabs-speech"
    }
  ],
  "bundle": {
    "bundle": "gohort.bundle/v1",
    "artifacts": [
      {
        "type": "connector",
        "name": "{{name}}",
        "recipe": {
          "name": "{{name}}",
          "kind": "service",
          "template": "elevenlabs-speech",
          "desc": "ElevenLabs speech",
          "spec": {
            "config": [
              {
                "name": "model",
                "label": "Model",
                "default": "eleven_multilingual_v2"
              },
              {
                "name": "voice",
                "label": "Voice id",
                "help": "An ElevenLabs voice id; the speech settings' Voice overrides it when set, picked from the account's voices by name.",
                "default": "21m00Tcm4TlvDq8ikWAM"
              },
              {
                "name": "api_key",
                "label": "ElevenLabs API key",
                "type": "secret",
                "send": "header:xi-api-key",
                "help": "Kept with this connection, and sent only to the address it is given for.",
                "required": true
              }
            ],
            "provider": {
              "transport": "http",
              "base_url": "https://api.elevenlabs.io",
              "auth": {
                "secret": "api_key"
              },
              "operations": {
                "speak": {
                  "method": "POST",
                  "path": "/v1/text-to-speech/{voice}?output_format=mp3_44100_128",
                  "body": {
                    "text": "{text}",
                    "model_id": "{model}"
                  },
                  "read": "file"
                },
                "voices": {
                  "path": "/v1/voices"
                }
              },
              "health": {
                "call": "voices",
                "expect": "voices",
                "every_mins": 60
              }
            },
            "provides": [
              {
                "capability": "speech.synthesize",
                "steps": [
                  {
                    "call": "speak"
                  }
                ],
                "output": {
                  "audio": {
                    "from": "body"
                  }
                },
                "defaults": {
                  "voice": "{config.voice}",
                  "model": "{config.model}"
                }
              },
              {
                "capability": "speech.voices",
                "steps": [
                  {
                    "call": "voices"
                  }
                ],
                "output": {
                  "voices": {
                    "path": "voices",
                    "as": "json"
                  }
                }
              }
            ]
          }
        }
      }
    ]
  }
}

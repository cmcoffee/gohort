{
  "id": "openai-images",
  "title": "OpenAI (image generation)",
  "description": "OpenAI's image model as an image backend, declared as a service: its request, reply and price are data you can test and fix from Admin > Connectors.",
  "category": "Images",
  "setup_notes": "Create an API key at platform.openai.com/api-keys. Choose it under Capabilities > Image Generation, where its model is set and its key can be changed. The price per image is OpenAI's for a standard square image at the time this template was written; a wide image costs more, so edit the spec's cost if most of yours are wide or the price has changed.",
  "questions": [
    {
      "name": "name",
      "label": "Connector name",
      "help": "Lowercase letters, digits, dashes and underscores; the image provider picker lists it by this name.",
      "default": "openai-images"
    }
  ],
  "bundle": {
    "bundle": "gohort.bundle/v1",
    "artifacts": [
      {
        "type": "connector",
        "name": "{{name}}",
        "recipe": {
          "name": "{{name}}",
          "kind": "service",
          "template": "openai-images",
          "desc": "OpenAI image generation",
          "spec": {
            "config": [
              {
                "name": "model",
                "label": "Model",
                "help": "An OpenAI image model that takes a size and returns base64.",
                "default": "dall-e-3"
              },
              {
                "name": "api_key",
                "label": "OpenAI API key",
                "type": "secret",
                "send": "bearer",
                "help": "Kept with this connection, and sent only to the address it is given for.",
                "required": true
              }
            ],
            "provider": {
              "transport": "http",
              "base_url": "https://api.openai.com",
              "auth": {
                "secret": "api_key"
              },
              "operations": {
                "generate": {
                  "method": "POST",
                  "path": "/v1/images/generations",
                  "body": {
                    "model": "{model}",
                    "prompt": "{prompt}",
                    "n": 1,
                    "size": "{width}x{height}",
                    "quality": "standard",
                    "response_format": "b64_json"
                  }
                },
                "models": {
                  "path": "/v1/models"
                }
              },
              "health": {
                "call": "models",
                "expect": "data",
                "every_mins": 60
              }
            },
            "provides": [
              {
                "capability": "image.generate",
                "steps": [
                  {
                    "call": "generate"
                  }
                ],
                "output": {
                  "image": {
                    "path": "data.0.b64_json",
                    "as": "base64"
                  }
                },
                "defaults": {
                  "model": "{config.model}",
                  "width": 1024,
                  "height": 1024
                },
                "wide": {
                  "width": 1792,
                  "height": 1024
                },
                "cost": {
                  "per_call": 0.04
                }
              }
            ]
          }
        }
      }
    ]
  }
}

{
  "id": "openai-transcription",
  "title": "OpenAI (transcription)",
  "description": "OpenAI's transcription model as gohort's ears, declared as a service: the upload and the reply are data you can test and fix from Admin > Connectors.",
  "category": "Speech",
  "setup_notes": "Create an API key at platform.openai.com/api-keys. Choose it under Capabilities > Audio Transcription, where its model is set and its key can be changed; Test there sends one second of a tone. OpenAI bills transcription by the minute, which gohort does not count, so no price is declared: the connector shows its calls as unpriced until you add a per_call cost to its spec.",
  "questions": [
    {
      "name": "name",
      "label": "Connector name",
      "help": "Lowercase letters, digits, dashes and underscores; the transcription settings list it by this name.",
      "default": "openai-transcription"
    }
  ],
  "bundle": {
    "bundle": "gohort.bundle/v1",
    "artifacts": [
      {
        "type": "connector",
        "name": "{{name}}",
        "recipe": {
          "name": "{{name}}",
          "kind": "service",
          "template": "openai-transcription",
          "desc": "OpenAI transcription",
          "spec": {
            "config": [
              {
                "name": "model",
                "label": "Model",
                "default": "whisper-1"
              },
              {
                "name": "api_key",
                "label": "OpenAI API key",
                "type": "secret",
                "send": "bearer",
                "help": "Kept with this connection, and sent only to the address it is given for.",
                "required": true
              }
            ],
            "provider": {
              "transport": "http",
              "base_url": "https://api.openai.com",
              "auth": {
                "secret": "api_key"
              },
              "operations": {
                "transcribe": {
                  "method": "POST",
                  "path": "/v1/audio/transcriptions",
                  "send": "multipart",
                  "body": {
                    "file": "{audio}",
                    "model": "{model}",
                    "prompt": "{prompt}",
                    "language": "{language}"
                  }
                },
                "models": {
                  "path": "/v1/models"
                }
              },
              "health": {
                "call": "models",
                "expect": "data",
                "every_mins": 60
              }
            },
            "provides": [
              {
                "capability": "speech.transcribe",
                "steps": [
                  {
                    "call": "transcribe"
                  }
                ],
                "output": {
                  "text": {
                    "path": "text",
                    "as": "text"
                  }
                },
                "defaults": {
                  "model": "{config.model}"
                }
              }
            ]
          }
        }
      }
    ]
  }
}

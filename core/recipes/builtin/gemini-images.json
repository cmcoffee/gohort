{
  "id": "gemini-images",
  "title": "Gemini (image generation)",
  "description": "Google's Gemini image model as an image backend, declared as a service: its request, reply and price are data you can test and fix from Admin > Connectors.",
  "category": "Images",
  "setup_notes": "Get an API key at aistudio.google.com/apikey. Choose it under Capabilities > Image Generation, where its model is set and its key can be changed. The price per image is set to Google's at the time this template was written: edit the spec's cost if it has changed.",
  "questions": [
    {
      "name": "name",
      "label": "Connector name",
      "help": "Lowercase letters, digits, dashes and underscores; the image provider picker lists it by this name.",
      "default": "gemini-images"
    }
  ],
  "bundle": {
    "bundle": "gohort.bundle/v1",
    "artifacts": [
      {
        "type": "connector",
        "name": "{{name}}",
        "recipe": {
          "name": "{{name}}",
          "kind": "service",
          "template": "gemini-images",
          "desc": "Gemini image generation",
          "spec": {
            "config": [
              {
                "name": "model",
                "label": "Model",
                "help": "A Gemini model that returns images.",
                "default": "gemini-2.5-flash-image"
              },
              {
                "name": "api_key",
                "label": "Gemini API key",
                "type": "secret",
                "send": "header:x-goog-api-key",
                "help": "Kept with this connection, and sent only to the address it is given for.",
                "required": true
              }
            ],
            "provider": {
              "transport": "http",
              "base_url": "https://generativelanguage.googleapis.com",
              "auth": {
                "secret": "api_key"
              },
              "operations": {
                "generate": {
                  "method": "POST",
                  "path": "/v1beta/models/{model}:generateContent",
                  "body": {
                    "contents": [
                      {
                        "parts": [
                          {
                            "text": "{prompt}"
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "responseModalities": [
                        "TEXT",
                        "IMAGE"
                      ],
                      "imageConfig": {
                        "aspectRatio": "{aspect}"
                      }
                    }
                  }
                },
                "models": {
                  "path": "/v1beta/models"
                }
              },
              "health": {
                "call": "models",
                "expect": "models",
                "every_mins": 60
              }
            },
            "provides": [
              {
                "capability": "image.generate",
                "steps": [
                  {
                    "call": "generate"
                  }
                ],
                "output": {
                  "image": {
                    "path": "candidates.0.content.parts[inlineData].inlineData.data",
                    "as": "base64"
                  }
                },
                "defaults": {
                  "model": "{config.model}",
                  "aspect": "1:1"
                },
                "wide": {
                  "aspect": "16:9"
                },
                "cost": {
                  "per_call": 0.039
                }
              }
            ]
          }
        }
      }
    ]
  }
}

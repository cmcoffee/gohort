{
  "id": "gemini-images",
  "title": "Gemini (image generation and editing)",
  "description": "Google's Gemini image model as an image backend, declared as a service: it makes pictures from a prompt, and edits or blends up to ten pictures you give it (Pictures per blend, on its row's Settings, holds it to fewer for a model that takes fewer). Its requests, replies and price are data you can test and fix from Admin > Connectors.",
  "category": "Images",
  "setup_notes": "Get an API key at aistudio.google.com/apikey. Choose it under Admin > Services > Media Generation; its model, its key and how many pictures it blends at once are on its row's Settings. The price per image is set to Google's at the time this template was written: edit the spec's cost if it has changed.",
  "questions": [
    {
      "name": "name",
      "label": "Connector name",
      "help": "Lowercase letters, digits, dashes and underscores; the image provider picker lists it by this name.",
      "default": "gemini-images"
    }
  ],
  "bundle": {
    "bundle": "gohort.bundle/v1",
    "artifacts": [
      {
        "type": "connector",
        "name": "{{name}}",
        "recipe": {
          "name": "{{name}}",
          "kind": "service",
          "template": "gemini-images",
          "desc": "Gemini image generation and editing",
          "spec": {
            "config": [
              {
                "name": "model",
                "label": "Model",
                "help": "A Gemini model that returns images.",
                "default": "gemini-2.5-flash-image"
              },
              {
                "name": "api_key",
                "label": "Gemini API key",
                "type": "secret",
                "send": "header:x-goog-api-key",
                "help": "Kept with this connection, and sent only to the address it is given for.",
                "required": true
              }
            ],
            "provider": {
              "transport": "http",
              "base_url": "https://generativelanguage.googleapis.com",
              "auth": {
                "secret": "api_key"
              },
              "operations": {
                "generate": {
                  "method": "POST",
                  "path": "/v1beta/models/{model}:generateContent",
                  "body": {
                    "contents": [
                      {
                        "parts": [
                          {
                            "text": "{prompt}"
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "responseModalities": [
                        "TEXT",
                        "IMAGE"
                      ],
                      "imageConfig": {
                        "aspectRatio": "{aspect}"
                      }
                    }
                  }
                },
                "edit": {
                  "method": "POST",
                  "path": "/v1beta/models/{model}:generateContent",
                  "body": {
                    "contents": [
                      {
                        "parts": [
                          {
                            "text": "{prompt}"
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image.type}",
                              "data": "{image.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image2.type}",
                              "data": "{image2.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image3.type}",
                              "data": "{image3.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image4.type}",
                              "data": "{image4.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image5.type}",
                              "data": "{image5.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image6.type}",
                              "data": "{image6.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image7.type}",
                              "data": "{image7.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image8.type}",
                              "data": "{image8.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image9.type}",
                              "data": "{image9.base64}"
                            }
                          },
                          {
                            "inlineData": {
                              "mimeType": "{image10.type}",
                              "data": "{image10.base64}"
                            }
                          }
                        ]
                      }
                    ],
                    "generationConfig": {
                      "responseModalities": [
                        "TEXT",
                        "IMAGE"
                      ]
                    }
                  }
                },
                "models": {
                  "path": "/v1beta/models"
                }
              },
              "health": {
                "call": "models",
                "expect": "models",
                "every_mins": 60
              }
            },
            "provides": [
              {
                "capability": "image.generate",
                "steps": [
                  {
                    "call": "generate"
                  }
                ],
                "output": {
                  "image": {
                    "path": "candidates.0.content.parts[inlineData].inlineData.data",
                    "as": "base64"
                  }
                },
                "defaults": {
                  "model": "{config.model}",
                  "aspect": "1:1"
                },
                "wide": {
                  "aspect": "16:9"
                },
                "cost": {
                  "per_call": 0.039
                }
              },
              {
                "capability": "image.edit",
                "config": [
                  {
                    "name": "max_images",
                    "label": "Pictures per blend",
                    "type": "number",
                    "help": "At most how many pictures one edit or blend sends, up to 10. Lower it for a model that takes fewer.",
                    "default": "10",
                    "min": 1,
                    "max": 10
                  }
                ],
                "steps": [
                  {
                    "call": "edit"
                  }
                ],
                "output": {
                  "image": {
                    "path": "candidates.0.content.parts[inlineData].inlineData.data",
                    "as": "base64"
                  }
                },
                "defaults": {
                  "model": "{config.model}"
                },
                "cost": {
                  "per_call": 0.039
                },
                "pictures": "{config.max_images}"
              }
            ]
          }
        }
      }
    ]
  }
}

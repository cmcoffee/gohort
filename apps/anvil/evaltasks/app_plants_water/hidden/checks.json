[
  {
    "name": "adding a plant saves it",
    "script": "add_plant",
    "inputs": {
      "name": "Fern"
    },
    "expect": [
      {
        "path": "records.0.name",
        "equals": "Fern"
      }
    ]
  },
  {
    "name": "adding a plant saves how often to water it",
    "script": "add_plant",
    "inputs": {
      "name": "Fern",
      "water_days": "3"
    },
    "expect": [
      {
        "path": "records.0.water_days",
        "equals": 3
      }
    ]
  },
  {
    "name": "the list returns how often to water",
    "script": "plants",
    "records": [
      {
        "id": "p1",
        "kind": "plant",
        "name": "Fern",
        "water_days": 3
      }
    ],
    "expect": [
      {
        "path": "0.water_days",
        "equals": 3
      },
      {
        "path": "0.name",
        "equals": "Fern"
      }
    ]
  },
  {
    "name": "the page shows how often to water",
    "records": [
      {
        "id": "p1",
        "kind": "plant",
        "name": "Fern",
        "water_days": 3
      }
    ],
    "steps": [
      {
        "see": "Fern - every 3 days"
      }
    ]
  }
]
